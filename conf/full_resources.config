// BLISS full libraries: moderate concurrency on shared lugli allocation.
// Maximum submitted tasks, not a reservation of CPUs.
executor.queueSize = 8

process {
    withName: EXTRACT_UMI {
        cpus = 8
        memory = '16 GB'
        time = '24h'
    }
    withName: DIFFERENTIAL_DSB {
        time = '12h'
        memory = '16 GB'
    }
}
