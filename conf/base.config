process {
    errorStrategy = 'terminate'
    withLabel: small {
        memory = '4 GB'
        time = '2h'
    }
    // Full-library FASTQ preparation can outlast other small tasks.
    withName: EXTRACT_UMI {
        time = '12h'
    }
    withLabel: reporting {
        memory = '8 GB'
        time = '4h'
    }
    withLabel: mapping {
        memory = '16 GB'
        time = '12h'
    }
}

