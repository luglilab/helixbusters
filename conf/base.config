// Shared process defaults for BLISS/Helixbusters.
process {
    errorStrategy = 'terminate'

    withLabel: small {
        memory = '4 GB'
        time = '2h'
    }

    // Large full-library FASTQ preprocessing.
    // Extra CPUs improve speed only if prepare_bliss_reads.py is parallelized.
    withName: EXTRACT_UMI {
        cpus = 8
        memory = '16 GB'
        time = '24h'
    }

    withLabel: reporting {
        memory = '8 GB'
        time = '4h'
    }

    withLabel: mapping {
        memory = '16 GB'
        time = '12h'
    }
}
